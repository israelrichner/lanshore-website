# HubSpot portal 6603479 (NA2). Form GUIDs are not secrets but stay server-side
# so validation and hutk attribution run through our API proxies.

# Contact form (legacy HUBSPOT_FORM_ID still accepted as fallback)
HUBSPOT_FORM_ID_CONTACT=
# HUBSPOT_FORM_ID=

# Newsletter capture (Footer + end-of-blog). Section hidden when unset.
HUBSPOT_FORM_ID_NEWSLETTER=

# Gated white-paper downloads. Section uses registry in src/lib/whitePapers.ts.
HUBSPOT_FORM_ID_WHITEPAPER=

# Careers application form on /about/careers.
HUBSPOT_FORM_ID_CAREERS=

# Meetings scheduler embed URL (e.g. https://meetings-na2.hubspot.com/slug).
# Prefer the hubspot.com host; a branded domain only works if its DNS/TLS is healthy.
# Contact page #book section hidden when unset.
HUBSPOT_MEETINGS_URL=

# Force HubSpot tracker on non-canonical hosts (localhost, *.vercel.app previews).
# Values: unset | force
# NEXT_PUBLIC_HUBSPOT_TRACKING=force

# ---------------------------------------------------------------------------
# Studio admin (/studio) — P2 auth boundary.
# Names only; values live in Vercel -> Project -> Settings -> Environment
# Variables and are never committed. If any of the four marked REQUIRED is
# missing, the admin routes 404 and login refuses to start a flow — a
# half-configured deploy is a closed door, not an open one.
# ---------------------------------------------------------------------------

# REQUIRED. Google Cloud console -> Credentials -> OAuth client (Web application).
# Redirect URIs to register: https://lanshore.com/api/studio/auth/callback
# and http://localhost:3000/api/studio/auth/callback. Vercel preview hostnames
# are per-deployment and cannot be pre-registered, so the admin does not work
# on preview URLs — deliberate: a preview must not be able to publish.
GOOGLE_OAUTH_CLIENT_ID=
# REQUIRED, secret. Used for the authorization-code exchange.
GOOGLE_OAUTH_CLIENT_SECRET=

# REQUIRED. Comma-separated, lowercased, exact match. This is the gate.
# Empty or unset => NOBODY is authorized. Never read as "allow all".
ADMIN_ALLOWED_EMAILS=
# Optional extra condition, ANDed with the allowlist — never a substitute for
# it. Also used as Google's `hd` UI hint, which Google does not enforce.
ADMIN_ALLOWED_DOMAIN=

# REQUIRED, secret. >=32 random bytes; HMAC key for the session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs everyone out — that is the revocation lever.
ADMIN_SESSION_SECRET=

# P3 ONLY — the publishing write path. Documented here so a deploy knows what
# will be needed, but NOT consumed by P2. Do not wire these up early.
# Fine-grained PAT, single repo, Contents: read+write. It EXPIRES — record the
# date and the owner, because the failure mode is "Publish silently stops".
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=
